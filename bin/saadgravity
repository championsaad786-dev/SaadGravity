#!/usr/bin/env python3
import sys
import os

# Resolve symlinks so package_dir points to actual repo location
real_path = os.path.realpath(__file__)
package_dir = os.path.abspath(os.path.join(os.path.dirname(real_path), ".."))
if package_dir not in sys.path:
    sys.path.insert(0, package_dir)

from saadgravity.cli import main

if __name__ == "__main__":
    main()
